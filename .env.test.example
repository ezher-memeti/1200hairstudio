# Required. These must identify a disposable/non-production Supabase project.
SUPABASE_TEST_URL=
SUPABASE_TEST_PUBLISHABLE_KEY=
SUPABASE_TEST_SERVICE_ROLE_KEY=

# Required for a remote test project. Set this only after confirming the project
# contains no production data. Local Supabase URLs do not require this flag.
POS_TEST_ALLOW_REMOTE=NO

# Temporary development-only escape hatch. Required when SUPABASE_TEST_URL is
# deliberately set to the current application database URL.
POS_TEST_ALLOW_CURRENT_DB=NO
