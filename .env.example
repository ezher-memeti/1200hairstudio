GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
# Local development only; use a new absolute path outside this repository.
GOOGLE_REFRESH_TOKEN_OUTPUT_PATH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=
REMINDER_DELIVERY_SECRET=

# WhatsApp Cloud API: isolated admin test only (never NEXT_PUBLIC_).
# Use ONLY Meta's test phone-number ID and verified test recipients.
WHATSAPP_TEST_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Exact version shown in your Meta dashboard, including v (for example vXX.0).
WHATSAPP_API_VERSION=
# Comma-separated international digits, optional leading +; no spaces/punctuation within numbers.
WHATSAPP_TEST_RECIPIENTS=
# Separate random webhook handshake token and Meta App Secret (not the access token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
