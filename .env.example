# Server-side public site mode: live (default), coming_soon, under_construction.
# A Vercel environment change requires a new deployment. Never use NEXT_PUBLIC_.
APP_SITE_MODE=live

# Gmail API sending: server-only secrets in Vercel Production/Preview as needed.
# The same OAuth client must have issued the refresh token with gmail.send access.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Required for all Gmail sends. Exported local token files are NOT read at runtime.
GOOGLE_REFRESH_TOKEN=

# Local OAuth authorization only; not required for production sending.
GOOGLE_REDIRECT_URI=
# Local development only; use a new absolute path outside this repository.
GOOGLE_REFRESH_TOKEN_OUTPUT_PATH=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Site origin only (no credentials/path/query/hash):
# Production: https://1200hairstudio.ch (also enforced by the shared helper).
# Development: actual local server origin, including its port.
# Preview: explicit HTTPS preview origin or leave unset/use Vercel system URL.
# Vercel supplies NEXT_PUBLIC_VERCEL_ENV/URL/BRANCH_URL for browser/server parity.
# Auth destinations must be allowlisted separately in Supabase.
NEXT_PUBLIC_SITE_URL=
# Supabase Edge Function secret (not a Next.js URL fallback): set its
# REMINDER_DELIVERY_URL to https://1200hairstudio.ch/api/internal/appointment-reminder-email
REMINDER_DELIVERY_SECRET=

# WhatsApp Cloud API: isolated admin test only (never NEXT_PUBLIC_).
# Use ONLY Meta's test phone-number ID and verified test recipients.
WHATSAPP_TEST_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Exact version shown in your Meta dashboard, including v (for example vXX.0).
WHATSAPP_API_VERSION=
# Comma-separated international digits, optional leading +; no spaces/punctuation within numbers.
WHATSAPP_TEST_RECIPIENTS=
# Separate random webhook handshake token and Meta App Secret (not the access token).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Google Places API (New), server-only. Enable Place Details and billing in Google Cloud.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

# Optional GA4 web stream ID (public, not a secret). Only production + the
# configured HTTPS NEXT_PUBLIC_SITE_URL + explicit Analytics consent can load it.
# Disable Enhanced Measurement in the GA4 stream before enabling.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Admin Web Push: one persistent VAPID identity; never rotate automatically.
# Public P-256 key only; embedded in the browser bundle. Rebuild after configuring.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Server-only matching private key and contact URI (mailto:owner@example.com).
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Independent high-entropy bearer secret for the durable push queue job.
ADMIN_PUSH_JOB_SECRET=
